# Ejemplo simple de un cubo con UVs y normales
mtllib cubo.mtl
o cubo
g grupo_cubo
usemtl blanco

v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
vn 1.0 0.0 0.0
vn -1.0 0.0 0.0

# Frente
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Atrás
usemtl negro
f 6/2/2 5/1/2 8/4/2
f 6/2/2 8/4/2 7/3/2

# Arriba
usemtl blanco
f 4/1/3 3/2/3 7/3/3
f 4/1/3 7/3/3 8/4/3

# Abajo
f 5/1/4 6/2/4 2/3/4
f 5/1/4 2/3/4 1/4/4

# Derecha
usemtl negro
f 2/1/5 6/2/5 7/3/5
f 2/1/5 7/3/5 3/4/5

# Izquierda
usemtl blanco
f 5/1/6 1/2/6 4/3/6
f 5/1/6 4/3/6 8/4/6
